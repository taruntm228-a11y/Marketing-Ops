# Copy this file to .env.local and fill in real values there.
#   cp .env.example .env.local
#
# .env.local is git-ignored. This file is not — so never put a real key here.
# On Vercel the same names go in Settings -> Environment Variables.
#
# The app runs with NONE of these set. It falls back to the structural parser,
# which is how you can try it before signing up for anything.

# ---------------------------------------------------------------------------
# Model provider — set ONE of these to turn on AI extraction and scoring.
# ---------------------------------------------------------------------------

# Google AI Studio. Has a genuinely free tier. https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Anthropic. Pay-per-use, cents at this volume. https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional: override the model names if the defaults are retired.
# ---------------------------------------------------------------------------
# gemini-2.5-flash is closed to accounts made after mid-2026. Flash-Lite is the
# default here because it allows 500 free requests a day against 3.8-flash's 20.
# GOOGLE_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_MODEL=claude-haiku-5-5

# ---------------------------------------------------------------------------
# Database. Without these the app still harvests, it just forgets everything.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Locks /api/watch so only the schedule can trigger a re-harvest of every show.
# Any long random string. Vercel sends it as `Authorization: Bearer <value>`.
# ---------------------------------------------------------------------------
CRON_SECRET=

# Thinking level for Gemini: minimal | low | medium | high.
# Low by default — extraction and scoring are mechanical, and the budget is
# shared with the answer itself.
# GOOGLE_THINKING=low
