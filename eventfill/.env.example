# Copy this file to .env.local and fill in real values there.
#   cp .env.example .env.local
#
# .env.local is git-ignored. This file is not — so never put a real key here.
# On Vercel the same names go in Settings -> Environment Variables.
#
# The app runs with NONE of these set. It falls back to the structural parser,
# which is how you can try it before signing up for anything.

# ---------------------------------------------------------------------------
# Model provider — set ONE of these to turn on AI extraction and scoring.
# ---------------------------------------------------------------------------

# Google AI Studio. Has a genuinely free tier. https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Anthropic. Pay-per-use, cents at this volume. https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional: override the model names if the defaults are retired.
# ---------------------------------------------------------------------------
# GOOGLE_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-haiku-5-5
